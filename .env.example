DOCUMENT_PLATFORM_ENVIRONMENT=local
DOCUMENT_PLATFORM_LOG_LEVEL=INFO
DOCUMENT_PLATFORM_STORAGE_ROOT=data
DOCUMENT_PLATFORM_MAX_DOCUMENT_BYTES=20971520
DOCUMENT_PLATFORM_MAX_DOCUMENT_PAGES=50
DOCUMENT_PLATFORM_MAX_EXTRACTED_TEXT_CHARACTERS=1000000
DOCUMENT_PLATFORM_MINIMUM_EMBEDDED_TEXT_CHARACTERS=100
DOCUMENT_PLATFORM_TESSERACT_COMMAND=tesseract
DOCUMENT_PLATFORM_TESSERACT_LANGUAGE=eng
DOCUMENT_PLATFORM_TESSERACT_RASTER_DPI=200
DOCUMENT_PLATFORM_TESSERACT_PAGE_TIMEOUT_SECONDS=30
DOCUMENT_PLATFORM_DATABASE_URL=postgresql+asyncpg://document_platform:local-development-only@localhost:5432/document_platform
DOCUMENT_PLATFORM_TEMPORAL_TARGET_HOST=localhost:7233
DOCUMENT_PLATFORM_TEMPORAL_NAMESPACE=default
DOCUMENT_PLATFORM_TEMPORAL_TASK_QUEUE=document-processing
DOCUMENT_PLATFORM_DISPATCHER_OWNER=local-dispatcher
DOCUMENT_PLATFORM_DISPATCHER_BATCH_SIZE=10
DOCUMENT_PLATFORM_DISPATCHER_LEASE_SECONDS=30
DOCUMENT_PLATFORM_DISPATCHER_POLL_SECONDS=2
# Local worker demo only. Leave unset for ordinary processing.
# DOCUMENT_PLATFORM_FAULT_INJECTION_STAGE=EMBEDDED_TEXT_EXTRACTION
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
